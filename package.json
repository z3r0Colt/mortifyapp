{
  "name": "mortify",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "test": "vitest run --config vitest.config.js --configLoader native",
    "test:database": "node scripts/test-database.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "native:sync": "npm run build && node scripts/cap.cjs sync",
    "native:android": "node scripts/cap.cjs open android",
    "native:ios": "node scripts/cap.cjs open ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/eb-garamond": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/literata": "^5.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "deno": "^2.9.6",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
