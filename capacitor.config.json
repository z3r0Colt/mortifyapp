{
  "appId": "com.gentleking.mortify",
  "appName": "Mortify",
  "webDir": "dist",
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": { "symlink": true }
        }
      }
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#F5F0E6",
      "showSpinner": false
    },
    "StatusBar": { "style": "DEFAULT", "backgroundColor": "#F5F0E6" },
    "FirebaseMessaging": { "presentationOptions": ["alert"] }
  }
}
